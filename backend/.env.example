# Chave privada obrigatória para acesso ao Modo Arquiteto (/admin)
LARIUS_ADMIN_PRIVATE_KEY=troque-por-sua-chave-privada-forte
LARIUS_SESSION_SECRET=troque-por-um-segredo-hmac-aleatorio-longo

# Isolamento de Voz Clonada no Back-end (ElevenLabs, Cartesia ou XTTS)
# O front-end envia apenas o texto para /api/lariustts e nunca enxerga estes valores.
VOICE_PROVIDER=elevenlabs
VOICE_CLONE_ID=seu_voice_id_clonado_aqui
VOICE_API_KEY=sua_api_key_secreta_aqui
XTTS_ENDPOINT_URL=http://127.0.0.1:8020
